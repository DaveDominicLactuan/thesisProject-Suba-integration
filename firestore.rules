rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== USERS COLLECTION ==========
    // Allow authenticated users to read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Sub-collections under users
      match /images/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /sessions/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ========== SESSIONS IMAGES COLLECTION ==========
    // Allow authenticated users to read/write only their own sessions
    match /sessionsImages/{sessionId} {
      allow read: if request.auth != null && 
                     resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && 
                       resource.data.userId == request.auth.uid;
    }

    // ========== IMAGES COLLECTION ==========
    // Allow authenticated users to read/write only their own images
    match /images/{imageId} {
      allow read: if request.auth != null && 
                     resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && 
                       resource.data.userId == request.auth.uid;
    }

    // ========== PENDING ACCOUNTS COLLECTION ==========
    // Allow public read for now (can be restricted later)
    // Only allow write during registration (via Cloud Functions ideally)
    match /pendingAccounts/{userId} {
      allow read: if true;  // Admin can review
      allow create: if request.auth != null && 
                       request.resource.data.userID == request.auth.uid;
      allow update, delete: if request.auth.token.admin == true;
    }

    // ========== DENY ALL OTHER ACCESS ==========
    // Default deny for any other collections/paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
